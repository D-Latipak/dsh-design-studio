{
  "id": "poster-a4-photo",
  "name": "A4 海报 · 照片顶栏 + 深色文字区",
  "when": "有照片/插画，要 A4 印刷海报：照片占上方约一半、文字全部压在深色区（避免浅底压字看不清）",
  "format": { "preset": "A4", "intent": "print", "bleed": 8.5, "margins": 0 },
  "palette": "ink-night",
  "mode": "cmyk",
  "slots": {
    "photo": { "type": "image", "required": true, "hint": "designs/assets/xxx.jpg（建议短边 ≥ 1600px）" },
    "kicker": { "default": "2026 · 秋季特展", "hint": "页眉小字，1 行，≤ 14 字" },
    "title": { "default": "标题", "hint": "主标题，2–4 字最佳（112pt 单行约 4 字）" },
    "en": { "default": "ENGLISH TITLE", "hint": "英文副标，大写" },
    "deck": { "default": "一句话导语。\n第二行补充说明。", "hint": "导语，最多 2 行" },
    "info": { "default": "展期 2026.11.08 – 12.20\n地点 · 开放时间", "hint": "信息区 2 行" },
    "price": { "default": "", "hint": "右下角标注（如「预售 68 / 现场 98」）；留空则整块不出" }
  },
  "ops": [
    { "as": "photoframe", "cmd": "frame.create", "params": { "rect": [-8.5, -8.5, 603.78, 440], "content": "graphic" } },
    { "cmd": "file.place", "params": { "path": "{{photo}}", "frame": "{{#photoframe.id}}" } },
    { "cmd": "object.fit", "params": { "mode": "fillProportionally", "ids": ["{{#photoframe.id}}"] } },
    { "as": "panel", "cmd": "frame.create", "params": { "rect": [-8.5, 435, 603.78, 850.39], "content": "graphic" } },
    { "cmd": "object.fill", "params": { "swatch": "Ink", "ids": ["{{#panel.id}}"] } },
    { "as": "kicker", "cmd": "frame.create", "params": { "rect": [62, 468, 420, 494], "content": "text", "text": "{{kicker}}" } },
    { "cmd": "text.selectStory", "params": { "frame": "{{#kicker.id}}", "point": [100, 480] } },
    { "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.sans}}", "size": 9.5, "tracking": 220, "fill": "Paper" } } },
    { "as": "rule", "cmd": "frame.create", "params": { "rect": [62, 506, 533, 507.5], "content": "graphic" } },
    { "cmd": "object.fill", "params": { "swatch": "Accent", "ids": ["{{#rule.id}}"] } },
    { "as": "title", "cmd": "frame.create", "params": { "rect": [80, 522, 545, 660], "content": "text", "text": "{{title}}" } },
    { "cmd": "text.selectStory", "params": { "frame": "{{#title.id}}", "point": [200, 580] } },
    { "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.serif}}", "size": 112, "tracking": 40, "fill": "Paper" } } },
    { "as": "en", "cmd": "frame.create", "params": { "rect": [82, 672, 533, 706], "content": "text", "text": "{{en}}" } },
    { "cmd": "text.selectStory", "params": { "frame": "{{#en.id}}", "point": [100, 686] } },
    { "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.sans}}", "size": 14, "tracking": 420, "fill": "Accent" } } },
    { "as": "deck", "cmd": "frame.create", "params": { "rect": [82, 720, 470, 772], "content": "text", "text": "{{deck}}" } },
    { "cmd": "text.selectStory", "params": { "frame": "{{#deck.id}}", "point": [100, 732] } },
    { "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.sans}}", "size": 10.5, "tracking": 20, "leading": { "kind": "points", "value": 17 }, "fill": "Paper" } } },
    { "as": "info", "cmd": "frame.create", "params": { "rect": [82, 790, 330, 822], "content": "text", "text": "{{info}}" } },
    { "cmd": "text.selectStory", "params": { "frame": "{{#info.id}}", "point": [100, 800] } },
    { "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.sans}}", "size": 8.5, "tracking": 60, "leading": { "kind": "points", "value": 13 }, "fill": "Paper" } } },
    { "when": "price", "as": "price", "cmd": "frame.create", "params": { "rect": [350, 790, 533, 822], "content": "text", "text": "{{price}}" } },
    { "when": "price", "cmd": "text.selectStory", "params": { "frame": "{{#price.id}}", "point": [400, 800] } },
    { "when": "price", "cmd": "type.char", "params": { "attrs": { "fontFamily": "{{font.sans}}", "size": 8.5, "tracking": 80, "fill": "Accent" } } },
    { "when": "price", "cmd": "type.para", "params": { "attrs": { "align": "right" } } },
    { "as": "foot", "cmd": "frame.create", "params": { "rect": [62, 828, 533, 829], "content": "graphic" } },
    { "cmd": "object.fill", "params": { "swatch": "Paper", "ids": ["{{#foot.id}}"] } },
    { "cmd": "object.opacity", "params": { "opacity": 0.3, "ids": ["{{#foot.id}}"] } }
  ]
}
